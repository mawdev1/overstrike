# The OVERSTRIKE platform control plane — accounts, profiles, matches, telemetry.
#
# Built from the REPOSITORY ROOT so the build context carries `platform/` and the root
# manifest that declares `pg`:
#
#   fly deploy --config fly.platform.toml --dockerfile Dockerfile.platform
#
# A third Fly app, separate from both the static site and the game server, because the
# three have genuinely different failure modes. The site is stateless and should stop when
# idle. The game server holds a live match and must not stop at all. This holds no match
# state but owns the database connection and the outbox relay, so it must survive a game
# server restart and be restartable without dropping a match.
#
# `pg` is a real dependency here, not a dev one. It was in neither package.json nor the
# lockfile until 2026-08-20 — it survived on one machine as an unsaved node_modules entry,
# so `npm ci` deleted it and every fresh clone, including CI, could not reach PostgreSQL at
# all. `npm ci --omit=dev` below is exactly the command that would have failed.
FROM node:22-slim

WORKDIR /app

# Manifest first, so editing a source file does not invalidate the dependency layer.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# `platform/` only. The simulation in `src/` is not imported by the control plane, and
# copying it would put the game's source in an image that has no use for it.
COPY platform ./platform

ENV NODE_ENV=production
ENV PLATFORM_PORT=8080
EXPOSE 8080

# Migrations are NOT run here.
#
# A container that migrates on boot races itself the moment there is more than one instance,
# and the loser either deadlocks on the advisory lock or applies a half-set. `fly deploy`
# runs them once as a release command (see fly.platform.toml), which is the one place that
# is guaranteed to happen exactly once per deployment.
#
# No init shim: platform/src/index.js installs SIGTERM/SIGINT handlers and drains in-flight
# requests before releasing the store, which is what the outbox depends on.
CMD ["node", "platform/src/index.js"]
