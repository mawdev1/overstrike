# The OVERSTRIKE dedicated game server.
#
# Built from the REPOSITORY ROOT, not from server/ — it copies both `src/` (the actual
# simulation, shared with the browser client) and `server/`, so the build context has to
# contain both:
#
#   fly deploy --config fly.gameserver.toml --dockerfile Dockerfile.gameserver
#
# Separate image and separate Fly app from the static site: the site is stateless and
# should stop when idle, this holds a live match and must not.
FROM node:22-slim

WORKDIR /app

# Manifest first, so editing a source file does not invalidate the dependency layer.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# The server imports the game's own source directly. That is the whole point of the
# conversion — one simulation, not a server reimplementation that drifts from the client.
COPY src ./src
COPY server ./server
COPY platform/src/shared ./platform/src/shared

# Two files out of platform/src/core, not the directory.
#
# server/index.js imports the platform's logger and its W3C trace-context helper so a match
# server's logs and correlation ids are the same shape as the control plane's. Both are
# self-contained — node:crypto and nothing else — so this copies exactly those two rather than
# core/, which would drag config, the store and the HTTP router into an image that has no use
# for them and would silently let a future import of any of them succeed.
#
# The image previously copied neither, and the game server crash-looped ten times on
# ERR_MODULE_NOT_FOUND for core/logger.js: the code was committed with the dependency and the
# Dockerfile was not.
COPY platform/src/core/logger.js ./platform/src/core/logger.js
COPY platform/src/core/observability.js ./platform/src/core/observability.js

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

# No init shim: index.js installs SIGTERM/SIGINT handlers and exits cleanly on its own,
# which scripts/wstest.mjs asserts.
CMD ["node", "server/index.js"]
